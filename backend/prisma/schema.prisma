generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Announcement {
  id         String   @id @default(uuid())
  companyId  String
  title      String
  body       String
  category   String   @default("Company")
  author     String   @default("HR Team")
  isPinned   Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Asset {
  id            String            @id @default(uuid())
  companyId     String
  type          String
  identifier    String?
  status        String            @default("available")
  condition     String?           @default("good")
  name          String?
  purchaseDate  DateTime?
  purchasePrice Decimal?          @db.Decimal(10, 2)
  serialNumber  String?
  warrantyUntil DateTime?
  company       Company           @relation(fields: [companyId], references: [id])
  assignments   AssetAssignment[]
}

model AssetAssignment {
  id         String    @id @default(uuid())
  assetId    String
  employeeId String
  assignedAt DateTime  @default(now())
  returnedAt DateTime?
  notes      String?
  asset      Asset     @relation(fields: [assetId], references: [id])
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model AttendanceLog {
  id                   String                  @id @default(uuid())
  employeeId           String
  date                 DateTime
  checkIn              DateTime?
  checkOut             DateTime?
  method               String?
  latitude             Float?
  longitude            Float?
  status               String                  @default("present")
  overtimeMinutes      Int                     @default(0)
  correctionOf         String?
  isWithinGeofence     Boolean?
  regularizationNote   String?
  regularizationStatus String?
  shiftId              String?
  shiftStart           String?
  shiftEnd             String?
  requiredMinutes      Int?
  workedMinutes        Int?                    @default(0)
  lateMinutes          Int?                    @default(0)
  lateStatus           String?                 @default("on_time")
  attendanceStatus     String?
  isWeeklyOff          Boolean                 @default(false)
  compOffCredited      Boolean                 @default(false)
  employee             Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift                Shift?                  @relation(fields: [shiftId], references: [id])
  regularizations      RegularizationRequest[]
  attendanceAudits     AttendanceAudit[]
  compOffBalances      CompOffBalance[]

  @@index([employeeId, date])
  @@index([shiftId])
}

model RegularizationRequest {
  id                String        @id @default(uuid())
  attendanceLogId   String
  employeeId        String
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  reason            String
  status            String        @default("pending") // pending, approved, rejected
  type              String        @default("regularization") // regularization | full_day
  resolutionNote    String?
  approverId        String?
  createdAt         DateTime      @default(now())
  attendanceLog     AttendanceLog @relation(fields: [attendanceLogId], references: [id], onDelete: Cascade)
  employee          Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model AttendanceAudit {
  id              String         @id @default(uuid())
  companyId       String
  employeeId      String
  attendanceLogId String?
  action          String
  fromValue       String?
  toValue         String?
  actorId         String?
  actorRole       String?
  notes           String?
  createdAt       DateTime       @default(now())
  company         Company        @relation(fields: [companyId], references: [id])
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceLog   AttendanceLog? @relation(fields: [attendanceLogId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([employeeId, createdAt])
}

model CompOffBalance {
  id               String         @id @default(uuid())
  companyId        String
  employeeId       String
  attendanceLogId  String?
  sourceType       String         @default("SECOND_SATURDAY")
  creditAmount     Float          @default(1)
  consumedAmount   Float          @default(0)
  status           String         @default("AVAILABLE") // AVAILABLE | CONSUMED | EXPIRED | VOID
  expiryDate       DateTime?
  consumedOn       DateTime?
  consumedBy       String?
  compOffRequestId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  company          Company        @relation(fields: [companyId], references: [id])
  employee         Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceLog    AttendanceLog? @relation(fields: [attendanceLogId], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@index([companyId, status])
}

model LeaveMonthlyBalance {
  id             String    @id @default(uuid())
  companyId      String
  employeeId     String
  leaveTypeId    String
  year           Int
  month          Int
  openingBalance Float     @default(0)
  allocated      Float     @default(0)
  carryForward   Float     @default(0)
  taken          Float     @default(0)
  pending        Float     @default(0)
  cancelled      Float     @default(0)
  adjusted       Float     @default(0)
  remaining      Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company   @relation(fields: [companyId], references: [id])
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year, month])
  @@index([companyId])
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])
}

model Branch {
  id        String     @id @default(uuid())
  companyId String
  name      String
  code      String?
  address   String?
  city      String?
  state     String?
  country   String?    @default("India")
  phone     String?
  pincode   String?
  isActive  Boolean    @default(true)
  company   Company    @relation(fields: [companyId], references: [id])
  employees Employee[]
}

model Candidate {
  id        String      @id @default(uuid())
  jobId     String
  name      String
  email     String
  resumeUrl String?
  stage     String      @default("applied")
  job       Job         @relation(fields: [jobId], references: [id])
  interview Interview[]
  offer     Offer[]
}

model Company {
  id             String   @id @default(uuid())
  name           String
  logoUrl        String?
  timezone       String   @default("Asia/Kolkata")
  currency       String   @default("INR")
  planId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  geofenceLat    Float?
  geofenceLng    Float?
  geofenceRadius Float?   @default(500)

  address              String?
  phone                String?
  email                String?
  website              String?
  gstNumber            String?
  panNumber            String?
  industry             String?
  companyType          String?
  financialYearStart   Int?
  financialYearEnd     Int?
  payrollEffectiveFrom Int?

  announcements           Announcement[]
  assets                  Asset[]
  auditLog                AuditLog[]
  branch                  Branch[]
  department              Department[]
  designation             Designation[]
  employees               Employee[]
  exitRequest             ExitRequest[]
  holiday                 Holiday[]
  invoice                 Invoice[]
  job                     Job[]
  leaveType               LeaveType[]
  leaveTransactions       LeaveTransaction[]
  leaveYears              LeaveYear[]
  project                 Project[]
  role                    Role[]
  setting                 Setting[]
  shift                   Shift[]
  shiftType               ShiftType[]
  reviewCycle             ReviewCycle[]
  subscription            Subscription[]
  users                   User[]
  tickets                 HelpdeskTicket[]
  loanRequests            LoanRequest[]
  shiftChangeRequests     ShiftChangeRequest[]
  compOffRequests         CompOffRequest[]
  flexibleHolidayRequests FlexibleHolidayRequest[]
  overtimeRequests        OvertimeRequest[]
  optionalHolidayRequests OptionalHolidayRequest[]
  leaveCancellations      LeaveCancellationRequest[]
  salaryRevisions         SalaryRevision[]
  taxDeclarations         TaxDeclaration[]
  kpas                    KPA[]
  kras                    KRA[]
  kpis                    KPI[]
  kpiAssignments          KPIAssignment[]
  kpiTargets              KPITarget[]
  evaluationSetups        EvaluationSetup[]
  evaluation360s          Evaluation360[]
  professionalTaxSlabs    ProfessionalTaxSlab[]
  pfConfigs               PFConfig[]
  esicConfigs             ESICConfig[]
  lwfConfigs              LWFConfig[]
  complianceForms         ComplianceForm[]
  tdsSlabs                TDSSlab[]
  tdsSections             TDSSection[]
  incomeSlabCategories    IncomeSlabCategory[]
  attendancePolicies      AttendancePolicy[]
  hrMasters               HRMaster[]
  importMappings          ImportMapping[]
  hrForms                 HRForm[]
  trainingCourses         TrainingCourse[]
  courseEnrollments       CourseEnrollment[]
  attendanceAudits        AttendanceAudit[]
  compOffBalances         CompOffBalance[]
  leaveMonthlyBalances    LeaveMonthlyBalance[]
}

model CourseEnrollment {
  id             String         @id @default(uuid())
  companyId      String
  courseId       String
  employeeId     String
  progress       Float          @default(0)
  completedAt    DateTime?
  trainingCourse TrainingCourse @relation(fields: [courseId], references: [id])
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId])
}

model Department {
  id        String     @id @default(uuid())
  companyId String
  name      String
  company   Company    @relation(fields: [companyId], references: [id])
  employees Employee[]
}

model Designation {
  id        String     @id @default(uuid())
  companyId String
  title     String
  grade     String?
  company   Company    @relation(fields: [companyId], references: [id])
  employees Employee[]
}

model Employee {
  id                      String                      @id @default(uuid())
  companyId               String
  employeeCode            String
  photoUrl                String?
  firstName               String
  middleName              String?
  lastName                String
  email                   String
  phone                   String?
  emergencyContact        String?
  address                 String?
  aadhaar                 String?
  pan                     String?
  passport                String?
  drivingLicense          String?
  uan                     String?
  esic                    String?
  pfNumber                String?
  bankAccountNumber       String?
  bankIfsc                String?
  joiningDate             DateTime?
  confirmationDate        DateTime?
  branchId                String?
  departmentId            String?
  designationId           String?
  managerId               String?
  employmentType          String?
  workLocation            String?
  status                  String                      @default("active")
  skills                  Json?
  education               Json?
  experience              Json?
  dob                     DateTime?
  state                   String?
  subDepartment           String?
  subDepartment1          String?
  subDepartment2          String?
  category                String?
  subCategory             String?
  grade                   String?
  reportingManager        String?
  reportingManager2       String?
  probation               String?
  notes                   String?
  workingDaysPerWeek      Int                         @default(5)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  assignments             AssetAssignment[]
  attendanceLog           AttendanceLog[]
  enrollments             CourseEnrollment[]
  branch                  Branch?                     @relation(fields: [branchId], references: [id])
  company                 Company                     @relation(fields: [companyId], references: [id])
  department              Department?                 @relation(fields: [departmentId], references: [id])
  designation             Designation?                @relation(fields: [designationId], references: [id])
  manager                 Employee?                   @relation("EmployeeToEmployee", fields: [managerId], references: [id])
  directReports           Employee[]                  @relation("EmployeeToEmployee")
  documents               EmployeeDocument[]
  exitRequest             ExitRequest?
  expense                 Expense[]
  fnfSettlement           FnfSettlement?
  goal                    Goal[]
  leaveBalances           LeaveBalance[]
  leaveRequest            LeaveRequest[]
  payslips                Payslip[]
  performanceReviews      PerformanceReview[]         @relation("Reviewee")
  reviewsGiven            PerformanceReview[]         @relation("Reviewer")
  salaryStructures        SalaryStructure[]
  additionalPayouts       AdditionalPayout[]
  shiftAssignment         ShiftAssignment[]
  timesheet               Timesheet[]
  travelRequest           TravelRequest[]
  user                    User?
  RegularizationRequest   RegularizationRequest[]
  tickets                 HelpdeskTicket[]
  loanRequests            LoanRequest[]
  shiftChangeRequests     ShiftChangeRequest[]
  compOffRequests         CompOffRequest[]
  flexibleHolidayRequests FlexibleHolidayRequest[]
  overtimeRequests        OvertimeRequest[]
  optionalHolidayRequests OptionalHolidayRequest[]
  leaveCancellations      LeaveCancellationRequest[]
  leaveTransactions       LeaveTransaction[]
  salaryRevisions         SalaryRevision[]
  taxDeclarations         TaxDeclaration[]
  contactInfo             EmployeeContactInfo?
  paymentInfo             EmployeePaymentInfo?
  adminInfo               EmployeeAdminInfo?
  personalInfo            EmployeePersonalInfo?
  familyMembers           EmployeeFamilyMember[]
  emergencyContacts       EmployeeEmergencyContact[]
  experiences             EmployeeExperienceInfo[]
  immigrations            EmployeeImmigrationInfo[]
  documentInfos           EmployeeDocumentInfo[]
  certifications          EmployeeCertificationInfo[]
  qualifications          EmployeeQualificationInfo[]
  kpiAssignments          KPIAssignment[]
  kpiTargets              KPITarget[]
  evaluationSetups        EvaluationSetup[]
  evaluation360s          Evaluation360[]
  attendanceAudits        AttendanceAudit[]
  compOffBalances         CompOffBalance[]
  leaveMonthlyBalances    LeaveMonthlyBalance[]

  @@unique([companyId, employeeCode])
  @@index([companyId, status])
}

model EmployeeDocument {
  id            String    @id @default(uuid())
  employeeId    String
  type          String
  fileUrl       String
  uploadedAt    DateTime  @default(now())
  isSigned      Boolean   @default(false)
  signedAt      DateTime?
  signatureHash String?
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model ExitChecklist {
  id            String      @id @default(uuid())
  exitRequestId String
  task          String
  completedAt   DateTime?
  completedBy   String?
  exitRequest   ExitRequest @relation(fields: [exitRequestId], references: [id], onDelete: Cascade)
}

model ExitRequest {
  id                String          @id @default(uuid())
  companyId         String
  employeeId        String          @unique
  resignationDate   DateTime
  lastWorkingDay    DateTime
  reason            String?
  exitInterviewNote String?
  status            String          @default("initiated")
  createdAt         DateTime        @default(now())
  checklists        ExitChecklist[]
  company           Company         @relation(fields: [companyId], references: [id])
  employee          Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Expense {
  id         String   @id @default(uuid())
  employeeId String
  category   String
  amount     Decimal  @db.Decimal(10, 2)
  status     String   @default("pending")
  receiptUrl String?
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model FnfSettlement {
  id                 String   @id @default(uuid())
  employeeId         String   @unique
  lastWorkingDay     DateTime
  noticePeriodDays   Int      @default(0)
  noticeRecovery     Decimal  @default(0) @db.Decimal(10, 2)
  unpaidSalaryDays   Int      @default(0)
  unpaidSalaryAmt    Decimal  @default(0) @db.Decimal(10, 2)
  gratuityAmount     Decimal  @default(0) @db.Decimal(10, 2)
  leaveEncashDays    Float    @default(0)
  leaveEncashAmount  Decimal  @default(0) @db.Decimal(10, 2)
  otherDeductions    Decimal  @default(0) @db.Decimal(10, 2)
  netSettlement      Decimal  @db.Decimal(10, 2)
  isGratuityEligible Boolean  @default(false)
  status             String   @default("draft")
  createdAt          DateTime @default(now())
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Goal {
  id          String    @id @default(uuid())
  employeeId  String
  title       String
  description String?
  progress    Float     @default(0)
  status      String    @default("pending")
  dueDate     DateTime?
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Holiday {
  id        String   @id @default(uuid())
  companyId String
  name      String
  date      DateTime
  company   Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, date])
}

model Integration {
  id        String @id @default(uuid())
  companyId String
  provider  String
  status    String @default("disconnected")
  config    Json?

  @@unique([companyId, provider])
}

model Interview {
  id          String    @id @default(uuid())
  candidateId String
  scheduledAt DateTime
  interviewer String?
  feedback    String?
  rating      Int?
  candidate   Candidate @relation(fields: [candidateId], references: [id])
}

model Invoice {
  id             String        @id @default(uuid())
  companyId      String
  subscriptionId String?
  amount         Decimal       @db.Decimal(10, 2)
  gstAmount      Decimal       @default(0) @db.Decimal(10, 2)
  status         String        @default("unpaid")
  issuedAt       DateTime      @default(now())
  company        Company       @relation(fields: [companyId], references: [id])
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
}

model Job {
  id          String      @id @default(uuid())
  companyId   String
  title       String
  description String?
  status      String      @default("open")
  candidates  Candidate[]
  company     Company     @relation(fields: [companyId], references: [id])
}

model LeaveBalance {
  id          String    @id @default(uuid())
  employeeId  String
  leaveTypeId String
  year        Int
  allotted    Float     @default(0)
  used        Float     @default(0)
  carriedOver Float     @default(0)
  encashed    Float     @default(0)
  pending     Float     @default(0)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id            String                     @id @default(uuid())
  employeeId    String
  leaveTypeId   String
  startDate     DateTime
  endDate       DateTime
  isHalfDay     Boolean                    @default(false)
  reason        String?
  status        String                     @default("pending")
  approverId    String?
  createdAt     DateTime                   @default(now())
  employee      Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType     LeaveType                  @relation(fields: [leaveTypeId], references: [id])
  cancellations LeaveCancellationRequest[]
  transactions  LeaveTransaction[]

  @@index([employeeId, status])
  @@index([status])
}

model LeaveType {
  id                     String         @id @default(uuid())
  companyId              String
  code                   String?
  name                   String
  paid                   Boolean        @default(true)
  accrualRate            Float          @default(0)
  annualAllocation       Float          @default(0)
  maxConsecutiveDays     Float?
  halfDayAllowed         Boolean        @default(true)
  carryForward           Boolean        @default(false)
  carryForwardLimit      Float?
  encashment             Boolean        @default(false)
  negativeBalanceAllowed Boolean        @default(false)
  attachmentRequired     Boolean        @default(false)
  applicableAfterDays    Float?
  approvalRequired       Boolean        @default(true)
  gender                 String?
  isActive               Boolean        @default(true)
  leaveBalances          LeaveBalance[]
  leaveRequest           LeaveRequest[]
  leaveTransactions      LeaveTransaction[]
  monthlyBalances        LeaveMonthlyBalance[]
  company                Company        @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId])
}

model Offer {
  id          String    @id @default(uuid())
  candidateId String
  ctc         Decimal   @db.Decimal(10, 2)
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id])
}

model PayrollCycle {
  id        String    @id @default(uuid())
  companyId String
  month     Int
  year      Int
  status    String    @default("draft")
  payslips  Payslip[]

  @@unique([companyId, month, year])
}

model Payslip {
  id              String       @id @default(uuid())
  employeeId      String
  payrollCycleId  String
  grossPay        Decimal      @db.Decimal(10, 2)
  totalDeductions Decimal      @db.Decimal(10, 2)
  netPay          Decimal      @db.Decimal(10, 2)
  breakdown       Json
  generatedAt     DateTime     @default(now())
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollCycle    PayrollCycle @relation(fields: [payrollCycleId], references: [id])

  @@index([employeeId, payrollCycleId])
}

model AdditionalPayout {
  id         String   @id @default(uuid())
  employeeId String
  month      Int
  year       Int
  type       String
  amount     Decimal  @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model ReviewCycle {
  id        String   @id @default(uuid())
  companyId String
  name      String // e.g., "Q1 2026 Performance Review"
  startDate DateTime
  endDate   DateTime
  status    String   @default("active") // active, closed
  company   Company  @relation(fields: [companyId], references: [id])
}

model PerformanceReview {
  id         String   @id @default(uuid())
  employeeId String
  reviewerId String
  cycle      String
  type       String // "self", "peer", "manager"
  score      Float?
  comments   String?
  createdAt  DateTime @default(now())
  employee   Employee @relation("Reviewee", fields: [employeeId], references: [id])
  reviewer   Employee @relation("Reviewer", fields: [reviewerId], references: [id])
}

model Permission {
  id     String @id @default(uuid())
  roleId String
  module String
  action String
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([roleId, module, action])
}

model Project {
  id            String      @id @default(uuid())
  companyId     String
  name          String
  status        String      @default("active")
  billableHours Float       @default(0)
  billedAmount  Decimal     @default(0) @db.Decimal(10, 2)
  company       Company     @relation(fields: [companyId], references: [id])
  tasks         Task[]
  timesheet     Timesheet[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id          String       @id @default(uuid())
  companyId   String
  name        String
  isSystem    Boolean      @default(false)
  permissions Permission[]
  company     Company      @relation(fields: [companyId], references: [id])
  users       User[]
}

model SalaryStructure {
  id               String   @id @default(uuid())
  employeeId       String
  effectiveFrom    DateTime
  createdAt        DateTime @default(now())
  basic            Decimal  @db.Decimal(10, 2)
  hra              Decimal  @default(0) @db.Decimal(10, 2)
  da               Decimal  @default(0) @db.Decimal(10, 2)
  conveyance       Decimal  @default(0) @db.Decimal(10, 2)
  medical          Decimal  @default(0) @db.Decimal(10, 2)
  specialAllowance Decimal  @default(0) @db.Decimal(10, 2)
  pfDeduction      Decimal  @default(0) @db.Decimal(10, 2)
  esiDeduction     Decimal  @default(0) @db.Decimal(10, 2)
  ptDeduction      Decimal  @default(0) @db.Decimal(10, 2)
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Setting {
  id        String  @id @default(uuid())
  companyId String
  key       String
  value     Json
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
}

model ShiftType {
  id                       String  @id @default(uuid())
  companyId                String
  name                     String
  defaultStartTime         String
  defaultEndTime           String
  isFlexible               Boolean @default(false)
  graceMinutes             Int     @default(10)
  coreHoursStart           String?
  coreHoursEnd             String?
  overtimeThresholdMinutes Int     @default(480)
  isActive                 Boolean @default(true)
  company                  Company @relation(fields: [companyId], references: [id])
  shifts                   Shift[]
}

model Shift {
  id                      String               @id @default(uuid())
  companyId               String
  name                    String
  startTime               String
  endTime                 String
  type                    String               @default("fixed")
  allowance               Decimal              @default(0) @db.Decimal(10, 2) // Extra pay per shift
  shiftTypeId             String?
  company                 Company              @relation(fields: [companyId], references: [id])
  shiftType               ShiftType?           @relation(fields: [shiftTypeId], references: [id])
  shiftAssignment         ShiftAssignment[]
  shiftChangeRequests     ShiftChangeRequest[]
  requestedChangeRequests ShiftChangeRequest[] @relation("RequestedShift")
  attendanceLogs          AttendanceLog[]
}

model ShiftAssignment {
  id            String    @id @default(uuid())
  shiftId       String
  employeeId    String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  rosterWeek    String?
  weekDay       Int?
