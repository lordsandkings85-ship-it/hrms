DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/db_name"
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=5000
REDIS_HOST=localhost
REDIS_PORT=6379
# 32+ byte secret used for AES-256-GCM PII encryption (openssl rand -hex 32)
ENCRYPTION_KEY=""
# Comma-separated allow-list of origins that may call the API with credentials
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
# SMTP settings for payslip emails (empty = email disabled)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""