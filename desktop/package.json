{
  "name": "workora-hrms-desktop",
  "version": "3.2.2",
  "description": "Workora HRMS — Enterprise Human Resource Management System",
  "author": "Lords & Kings Enterprise",
  "license": "MIT",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:frontend": "cd ../frontend && npm run build",
    "build:desktop": "electron-vite build",
    "copy:renderer": "node -e \"const fs = require('fs'); fs.cpSync('../frontend/dist', 'dist/renderer', { recursive: true });\"",
    "build:all": "npm run build:frontend && npm run build:desktop && npm run copy:renderer",
    "build:win": "npm run build:all && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --publish never",
    "build:mac:arm64": "npm run build:all && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --publish never",
    "build:mac:x64": "npm run build:all && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64 --publish never",
    "build:mac": "npm run build:mac:arm64 && npm run build:mac:x64",
    "electron:build:win": "npm run build:win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^10.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "^5.5.4"
  },
  "build": {
    "appId": "com.workora.hrms",
    "productName": "Workora HRMS",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Workora HRMS",
      "artifactName": "Workora-HRMS-Setup-${version}.${ext}",
      "uninstallDisplayName": "Workora HRMS",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Workora-HRMS-${arch}-${version}.${ext}"
    },
    "dmg": {
      "title": "Workora HRMS ${arch}",
      "sign": false,
      "writeUpdateInfo": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "lordsandkings85-ship-it",
      "repo": "hrms",
      "releaseType": "release"
    }
  }
}
